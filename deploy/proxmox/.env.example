# Copy to .env next to deploy/proxmox/docker-compose.yml. Never commit .env.
TZ=Etc/UTC

# Space-separated SteamID64s that get admin on both servers
ADMINLIST_IDS=

# --- vanilla (UDP 2456-2457) ---
VANILLA_SERVER_NAME=Absolute Valheim
VANILLA_WORLD_NAME=Midgard
VANILLA_SERVER_PASS=change-me-please
VANILLA_SERVER_PUBLIC=false
VANILLA_UPDATE_CRON=30 5 * * *
VANILLA_TAG=latest

# --- bepinex (UDP 2466-2467) ---
BEPINEX_SERVER_NAME=Absolute Valheim (Modded)
BEPINEX_WORLD_NAME=Asgard
BEPINEX_SERVER_PASS=change-me-too
BEPINEX_UPDATE_ON_START=true
# Cron schedule for automated Valheim updates (default: 4:00 AM daily; empty = manual only)
BEPINEX_UPDATE_CRON=0 4 * * *
# Number of plugins you installed; modcheck fails if fewer load after an update
BEPINEX_EXPECT_PLUGINS=
# hold | rollback | vanilla  (docs/Disaster-Response.md)
BEPINEX_FAILURE_POLICY=hold
BEPINEX_TAG=bepinex
